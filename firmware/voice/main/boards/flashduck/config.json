{
    "type": "flashduck",
    "target": "esp32s3",
    "builds": [
        {
            "name": "flashduck",
            "build_options": {
                "camera_hmirror": true,
                "camera_vflip": true
            },
            "sdkconfig_append": [
                "CONFIG_HTTPD_WS_SUPPORT=y",
                "CONFIG_CAMERA_OV2640=y",
                "CONFIG_CAMERA_OV3660=y",
                "CONFIG_GC2145_SUPPORT=y",
                "CONFIG_WAKE_WORD_DETECTION_IN_LISTENING=y",
                "CONFIG_OTA_URL=\"http://YOUR_OTA_SERVER/xiaozhi/ota/\""
            ]
        }
    ]
}
